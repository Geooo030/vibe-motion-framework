# Set these in your process environment. Never commit a real API key.
DASHSCOPE_API_KEY=
# Defaults: Beijing. Singapore is selected by --region or the voice profile.
QWEN_TTS_ENROLLMENT_BASE_URL=
QWEN_TTS_SYNTHESIS_BASE_URL=
# Optional explicit executables; ffmpeg-static supplies audio filters, Remotion supplies ffprobe.
FFMPEG_PATH=
FFPROBE_PATH=
REMOTION_BROWSER_EXECUTABLE=
